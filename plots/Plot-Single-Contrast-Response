# 2) ORIGINAL FIGURES FUNCTIONS MODIFIED FOR OPTIMIZED VISUALIZATION
def cell_sensitivity_example_fig(filename,
                                 angle=0,
                                 stat_test_props = dict(interval_pre=[-1,0], 
                                                       interval_post=[1,2],
                                                       test='ttest',
                                                       sign='negative'), # CHANGED TO TARGET NEGATIVE DROPS
                                 response_significance_threshold = 0.01,
                                 Nsamples = 10, 
                                 color='#ff9ab5ff', # CUSTOM COLOR FOR RESPONSES
                                 seed=10):
    
    np.random.seed(seed)
    
    data = Data(filename, with_visual_stim=True)
    # Note: visual_stim is now built automatically with with_visual_stim=True
    # No need to call data.init_visual_stim() or EPISODES.init_visual_stim()

    EPISODES = EpisodeData(data,
                           quantities=['dFoF'],
                           protocol_id=np.flatnonzero(['8contrasts' in p for p in data.protocols]),
                           verbose=False) # Turned down verbosity for smoother terminal printouts 
    
    fig, AX = pt.plt.subplots(Nsamples, len(EPISODES.varied_parameters['contrast']), figsize=(9, 8))
    plt.subplots_adjust(right=0.75, left=0.1, top=0.95, bottom=0.08, wspace=0.1, hspace=0.8)
    
    for Ax in AX:
        for ax in Ax:
            ax.axis('off')

    for i, r in enumerate(np.random.choice(np.arange(data.nROIs), 
                                           min([Nsamples, data.nROIs]), replace=False)):

        # SHOW trial-average
        plot_trial_average(EPISODES,
                           condition=(EPISODES.angle==angle),
                           column_key='contrast',
                           color=color,
                           quantity='dFoF',
                           Ybar=1., Ybar_label='1dF/F',
                           Xbar=1., Xbar_label='1s',
                           roiIndex=r,
                           with_stat_test=True,
                           stat_test_props=stat_test_props,
                           with_screen_inset=False,
                           AX=[AX[i]], no_set=False)
        AX[i][0].annotate('roi #%i  ' % (r+1), (0,0), ha='right', xycoords='axes fraction')

        # SHOW summary angle dependence
        inset = pt.inset(AX[i][-1], (2.2, 0.2, 1.2, 0.8))

        contrasts, y, sy = [], [], []

        for c, contrast in enumerate(EPISODES.varied_parameters['contrast']):

            stats = EPISODES.stat_test_for_evoked_responses(
                episode_cond=EPISODES.find_episode_cond(key=['angle', 'contrast'], value=[angle, contrast]),
                response_args=dict(quantity='dFoF', roiIndex=r),
                **stat_test_props
            )

            contrasts.append(contrast)
            y.append(np.mean(stats.y - stats.x))    # means "post-pre"
            sy.append(np.std(stats.y - stats.x))     # std "post-pre"

        pt.scatter(contrasts, np.array(y), sy=np.array(sy), ax=inset, ms=1, lw=1, color=color)
        inset.plot(contrasts, 0*np.array(contrasts), 'k:', lw=0.5)
        inset.set_ylabel('$\\delta$ $\\Delta$F/F     ', fontsize=7)
        inset.set_xticks([0,1])
        
    inset.set_xlabel('contrast', fontsize=7)
    return fig

